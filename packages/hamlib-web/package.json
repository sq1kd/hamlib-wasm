{
  "name": "hamlib-web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Hamlib CAT control in the browser over Web Serial, compiled to WebAssembly",
  "keywords": [
    "hamlib",
    "wasm",
    "webassembly",
    "web-serial",
    "ham-radio",
    "cat"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./wasm": {
      "types": "./dist/native/hamlib-web.d.mts",
      "default": "./dist/native/hamlib-web.mjs"
    },
    "./wasm/hamlib-web.wasm": "./dist/native/hamlib-web.wasm",
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./third_party/*": "./dist/third_party/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@types/w3c-web-serial": "1.0.8"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build/package.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "yaml": "2.9.1"
  }
}
