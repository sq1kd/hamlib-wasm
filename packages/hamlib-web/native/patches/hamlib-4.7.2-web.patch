+/*
+ * Web serial transport: writes and readiness checks on a serial port go to
+ * the browser transport (Web Serial write()/waitReadable()) instead of
+ * write()/select(), which have no descriptor to work on.
+ */
+static ssize_t port_write(hamlib_port_t *p, const void *buf, size_t count)
+{
+    if (p->type.rig == RIG_PORT_SERIAL)
+    {
+        return webserial_write(p, buf, count);
+    }
+
+    return write(p->fd, buf, count);
+}
+
+static int port_select(hamlib_port_t *p, int n, fd_set *readfds,
+                       fd_set *writefds, fd_set *exceptfds,
+                       struct timeval *timeout, int direct)
+{
+    /*
+     * select() always clears writefds/exceptfds and rewrites readfds.  The
+     * browser transport has no exceptional conditions, so leaving those bits
+     * set would make port_wait_for_data_direct() report a spurious EIO.
+     */
+    if (exceptfds) { FD_ZERO(exceptfds); }
+
+    if (writefds) { FD_ZERO(writefds); }
+
+    if (direct && p->type.rig == RIG_PORT_SERIAL)
+    {
+        return webserial_select(p, readfds, timeout);
+    }
+
+    return select(n, readfds, writefds, exceptfds, timeout);
+}
+
+#else
 #define port_write(p,b,c) write((p)->fd,(b),(c))
 #define port_select(p,n,r,w,e,t,d) select((n),(r),(w),(e),(t))
+#endif
