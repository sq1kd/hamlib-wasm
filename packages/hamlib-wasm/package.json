{
  "name": "hamlib-wasm",
  "version": "0.1.0",
  "license": "MIT AND LGPL-2.1-or-later",
  "type": "module",
  "description": "Hamlib CAT control in the browser over Web Serial or in Node over node-serialport, compiled to WebAssembly",
  "keywords": [
    "hamlib",
    "wasm",
    "webassembly",
    "web-serial",
    "node",
    "electron",
    "ham-radio",
    "cat"
  ],
  "homepage": "https://github.com/sq1kd/hamlib-wasm#readme",
  "bugs": {
    "url": "https://github.com/sq1kd/hamlib-wasm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sq1kd/hamlib-wasm.git",
    "directory": "packages/hamlib-wasm"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./raw": {
      "types": "./dist/raw.d.ts",
      "default": "./dist/raw.js"
    },
    "./native/hamlib-wasm.wasm": "./dist/native/hamlib-wasm.wasm",
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./third_party/*": "./dist/third_party/*"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md",
    "REBUILDING.md",
    "README.md"
  ],
  "dependencies": {
    "@types/w3c-web-serial": "1.0.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "serialport": ">=12"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "serialport": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
