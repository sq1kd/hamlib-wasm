# Build the React landing page and publish it to GitHub Pages.
#
# The Wasm artifact is not committed (dist/ is ignored), and the React example
# embeds the built package, so this job runs the repository's own reproducible
# build through mise: fetch the pinned Hamlib release, verify its checksum,
# compile it with the pinned emsdk, then build the package and the example.
#
# The example is built with `base: './'`, so the same artifact works at
# https://<owner>.github.io/<repository>/ without knowing the repository name.
name: pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: jdx/mise-action@v2
        with:
          # Installs the pinned tools from mise.toml (Node 24.21.0, emsdk 6.0.10).
          install: true

      - run: npm ci

      - name: Build the package and the landing page
        run: mise run build-react

      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: examples/react/dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
