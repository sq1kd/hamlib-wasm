{
  "name": "hamlib-wasm-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Hamlib compiled to WebAssembly with a Web Serial transport, plus a browser example",
  "workspaces": [
    "packages/*",
    "examples/*",
    "tests/harness",
    "tests/node",
    "tests/hardware"
  ],
  "scripts": {
    "build": "node packages/hamlib-wasm/build/package.ts && npm run build --workspace examples/basic",
    "typecheck": "mise run typecheck",
    "test": "vitest run --config tests/hooks/vitest.config.ts && playwright test",
    "test:browser": "playwright test tests/browser/e2e",
    "dev": "npm run dev --workspace examples/basic",
    "build:harness": "npm run build --workspace tests/harness"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.0",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
