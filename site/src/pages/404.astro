---
/* Starlight's own 404 route would also try to render a `404` docs entry
 * through the catch-all docs route; owning the page here avoids both. */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<StarlightPage frontmatter={{ title: 'Page not found', template: 'splash' }}>
  <p>
    This page does not exist. Start from the <a href={home}>introduction</a> or the
    <a href={`${home}getting-started/`}>getting started guide</a>.
  </p>
</StarlightPage>
