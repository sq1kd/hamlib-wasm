---
/* Starlight's own 404 route would also try to render a `404` docs entry
 * through the catch-all docs route; owning the page here avoids both. */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import { served } from '../links';
---

<StarlightPage frontmatter={{ title: 'Page not found', template: 'splash' }}>
  <p>
    This page does not exist. Start from the <a href={served('')}>introduction</a> or the
    <a href={served('getting-started/')}>getting started guide</a>.
  </p>
</StarlightPage>
