---
/**
 * The landing page's hero, replacing Starlight's.
 *
 * Everything here is HTML at build time: the copy, the facts, the model list
 * and the radio panel with its controls.  Two small scripts bring it to life - the
 * waterfall behind it, and the panel, which loads Hamlib only once a reader
 * connects a radio.
 */
import { megabytes } from '../bytes';
import { CATALOGUE, DEMO_DOWNLOAD, HARDWARE_TESTED } from '../facts';
import { served } from '../links';
import { baudRates } from '../radio/detect';
import { NO_CAPABILITIES } from '../radio/format';
import { defaultModel } from '../radio/models';
import { RadioPanel } from '../radio/RadioPanel';
import { SAMPLE_STATE } from '../radio/simulate';
import { sampleView } from '../radio/views';
import '../radio/radio.css';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const primary = actions[0];

const { models, version } = CATALOGUE;
/* A returning reader's pick replaces this in the script. */
const initial = defaultModel(models);
---

<section class="hw-hero" aria-labelledby="_top">
  <canvas class="hw-waterfall" width="960" height="540" aria-hidden="true" data-waterfall></canvas>
  <div class="hw-wrap">
    <div class="hw-copy">
      <h1 id="_top" data-page-title set:html={title} />
      {tagline && <p class="hw-lede" set:html={tagline} />}
      <div class="hw-actions">
        {primary && <a class="hw-primary" href={primary.link}>{primary.text}</a>}
        <button class="hw-npm" type="button" data-copy="npm i hamlib-wasm" aria-label="Copy the install command">
          <span aria-hidden="true">$</span> npm i hamlib-wasm
        </button>
      </div>
      <dl class="hw-facts">
        <div><dt>{models.length}</dt><dd>serial radio models</dd></div>
        <div><dt>{megabytes(DEMO_DOWNLOAD.gzip)}</dt><dd>gzip, Hamlib {version}</dd></div>
        <div><dt>{HARDWARE_TESTED.map((radio) => radio.model).join(', ')}</dt><dd>tested on real radios</dd></div>
      </dl>
    </div>

    <div class="hw-side">
      <RadioPanel
        prerender
        view={sampleView(SAMPLE_STATE)}
        models={models}
        modelId={initial?.id}
        baud="auto"
        rates={initial === undefined ? [] : baudRates(initial)}
        serial
        locked={false}
        note="Tune it and key it, from the browser."
        link={{ href: served('demo/'), text: 'See every library call' }}
        controls={{
          capabilities: NO_CAPABILITIES,
          busy: false,
          onSetFrequency: () => undefined,
          onSetMode: () => undefined,
          onSetPassband: () => undefined,
          onSetPtt: () => undefined,
        }}
      />

      <pre class="hw-code"><code><span class="k">const</span> rig = <span class="k">await</span> hamlib.open({'{'} modelId, baudRate: <span class="s">38400</span> {'}'});
<span class="k">const</span> {'{'} frequency, mode {'}'} = <span class="k">await</span> rig.refresh();
<span class="k">await</span> rig.setFrequency(<span class="s">14_074_000</span>);  <span class="c">// Hz</span></code></pre>
    </div>
  </div>
</section>

<script>
  import { mountRadio } from '../landing/radio';
  import { startWaterfall } from '../landing/waterfall';
  import { emulate } from '../radio/emulate';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-waterfall]');
  const radio = document.querySelector<HTMLElement>('[data-radio]');

  if (canvas !== null) startWaterfall(canvas);
  if (radio !== null) mountRadio(radio, { emulated: await emulate() });

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', () => {
      void navigator.clipboard.writeText(button.dataset.copy ?? '').then(() => {
        button.dataset.copied = '';
        setTimeout(() => { delete button.dataset.copied; }, 1500);
      });
    });
  }
</script>

<style>
  /* The hero is a dark band in both themes: the radio is a lit display. */
  .hw-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--hw-bg);
    color: var(--hw-ink);
    min-height: calc(100svh - var(--sl-nav-height));
    display: grid;
    align-items: center;
  }

  .hw-waterfall {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    mask: linear-gradient(90deg, #0000 30%, #0006 48%, #000 72%) intersect, linear-gradient(#0000, #000 14%, #000 80%, #0000);
  }

  .hw-wrap {
    width: var(--hw-wrap);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 4rem;
    align-items: center;
    padding-block: 3rem;
  }

  h1 {
    font-size: clamp(2.4rem, 1.2rem + 3vw, 3.9rem);
    line-height: 1.03;
    letter-spacing: -0.022em;
    font-weight: 600;
    color: var(--hw-ink);
  }

  .hw-lede {
    font-size: 1.19rem;
    line-height: 1.55;
    margin-top: 1.4rem;
    max-width: 33em;
    color: var(--hw-muted);
  }

  .hw-actions { display: flex; gap: 0.75rem; margin-top: 2.1rem; flex-wrap: wrap; }

  .hw-actions .hw-primary { padding: 0.85rem 1.4rem; font: 500 1rem var(--__sl-font); }

  .hw-npm {
    font: 0.94rem var(--__sl-font-mono);
    padding: 0.8rem 1.1rem;
    border-radius: var(--hw-radius);
    background: color-mix(in srgb, var(--hw-well-raised) 90%, transparent);
    border: 1px solid var(--hw-line);
    color: var(--hw-ink);
    cursor: copy;
    transition: border-color 0.15s;
  }
  .hw-npm span { color: var(--hw-accent); }
  .hw-npm:hover { border-color: #33404c; }
  .hw-npm[data-copied]::after { content: '  copied'; color: var(--hw-accent); }

  .hw-facts { display: flex; flex-wrap: wrap; gap: 1rem 0; margin-top: 2.9rem; }
  .hw-facts div { padding-right: 1.4rem; margin-right: 1.4rem; border-right: 1px solid var(--hw-line); }
  .hw-facts div:last-child { border: 0; }
  .hw-facts dt { font: 500 1.35rem var(--__sl-font-mono); color: var(--hw-ink); }
  .hw-facts dd { margin: 0.1rem 0 0; font-size: 0.875rem; color: var(--hw-faint); }

  /* Lifted off the waterfall here; in the docs the panel sits flat, like the rest of the page. */
  .hw-side :global(.radio) { box-shadow: 0 40px 90px -30px #000; }

  .hw-code {
    margin-top: 1rem;
    background: color-mix(in srgb, var(--hw-well) 90%, transparent);
    border: 1px solid var(--hw-line);
    border-radius: var(--hw-radius);
    padding: 1rem 1.1rem;
    font: 0.84rem/1.7 var(--__sl-font-mono);
    color: var(--hw-ink-dim);
    overflow: auto;
  }
  .hw-code .k { color: var(--hw-accent); }
  .hw-code .s { color: var(--hw-tx); }
  .hw-code .c { color: var(--hw-faint); }

  @media (max-width: 62rem) {
    .hw-wrap { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .hw-waterfall { opacity: 0.35; mask: linear-gradient(#000 0, #0006 25%, #0000 45%); }
  }

  @media (max-width: 34rem) {
    .hw-primary, .hw-npm { width: 100%; justify-content: center; }
    .hw-facts div:nth-child(2) { border: 0; }
  }
</style>
