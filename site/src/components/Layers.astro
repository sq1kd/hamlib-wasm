---
/*
 * One call followed down the stack: the layer and its owner on the left, what
 * it hands to the next layer in the middle, what it does on the right.  The
 * payload column is the spine, so the eye follows the value as it changes.
 *
 * Plain HTML and CSS rather than a diagram library: it follows the theme,
 * reflows on a phone, reads as a list to a screen reader and ships no script.
 */
import { layers, OWNER_LABEL } from './layers';
---

<figure class="layers not-content">
  <ol>
    {
      layers.map((layer) => (
        <li data-owner={layer.owner}>
          <div class="who">
            <strong>{layer.name}</strong>
            <span class="owner">{OWNER_LABEL[layer.owner]}</span>
          </div>
          <div class="packet">
            <code>{layer.sees}</code>
          </div>
          <p class="role">{layer.role}</p>
        </li>
      ))
    }
  </ol>
  <figcaption>
    One <code>setFrequency</code> on a Kenwood TS-480, layer by layer. Any
    reply from the radio comes back up through the same layers.
  </figcaption>
</figure>

<style>
  .layers {
    --wire: var(--sl-color-gray-4);
    --arrow: 0.375rem;
    --step: 0.75rem;
    margin-block: 2rem;
  }

  /* Each owner's tone: teal for ours, grey for Hamlib, an outline for the rest. */
  [data-owner='ours'] {
    --tone: var(--sl-color-accent);
    --tone-bg: var(--sl-color-accent-low);
    --tone-ink: var(--sl-color-accent-high);
  }

  [data-owner='hamlib'] {
    --tone: var(--sl-color-gray-4);
    --tone-bg: var(--sl-color-gray-6);
    --tone-ink: var(--sl-color-gray-3);
  }

  [data-owner='you'],
  [data-owner='platform'] {
    --tone: var(--sl-color-gray-4);
    --tone-bg: var(--sl-color-black);
    --tone-ink: var(--sl-color-gray-3);
    --tone-style: dashed;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 10rem minmax(0, 19rem) minmax(0, 1fr);
    column-gap: 1.25rem;
    align-items: center;
  }

  .who {
    display: grid;
    text-align: end;
  }

  .who strong {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .owner {
    font-size: var(--sl-text-xs);
    color: var(--tone-ink);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* The spine: a wire through the whole column, broken only by the packets,
   * so it stays even however tall a row's text wraps. */
  .packet {
    position: relative;
    align-self: stretch;
    display: grid;
    align-items: center;
    padding-block: var(--step);
  }

  .packet::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    width: 2px;
    translate: -50% 0;
    background: var(--wire);
  }

  li:first-child .packet::before {
    top: 50%;
  }

  li:last-child .packet::before {
    bottom: 50%;
  }

  code {
    position: relative;
    padding: 0.5rem 0.75rem;
    border: 1px var(--tone-style, solid) var(--tone);
    border-radius: var(--hw-radius);
    background: var(--tone-bg);
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* Arrowhead where the wire meets each packet from above. */
  li:not(:first-child) code::before {
    content: '';
    position: absolute;
    inset-inline-start: 50%;
    bottom: 100%;
    translate: -50% 0;
    border-inline: var(--arrow) solid transparent;
    border-top: var(--arrow) solid var(--wire);
  }

  .role {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  /* On a phone each layer stacks, centred on the wire. */
  @media (max-width: 50rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
      text-align: center;
    }

    .who {
      text-align: center;
      padding-top: var(--step);
    }

    .packet {
      padding-block: 0.5rem;
    }

    .packet::before,
    li:not(:first-child) code::before {
      display: none;
    }

    li:not(:first-child) {
      position: relative;
      padding-top: calc(var(--step) * 2);
    }

    li:not(:first-child)::before {
      content: '';
      position: absolute;
      top: 0;
      inset-inline-start: 50%;
      width: 2px;
      height: calc(var(--step) * 2);
      translate: -50% 0;
      background: var(--wire);
    }

    li:not(:first-child)::after {
      content: '';
      position: absolute;
      top: calc(var(--step) * 2);
      inset-inline-start: 50%;
      translate: -50% 0;
      border-inline: var(--arrow) solid transparent;
      border-top: var(--arrow) solid var(--wire);
    }
  }
</style>
