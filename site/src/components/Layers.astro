---
/*
 * The stack one call travels, top to bottom: who owns each layer, and what
 * `rig.setFrequency(7_074_000)` on a TS-480 looks like when it passes through.
 *
 * Plain HTML and CSS rather than a diagram library: it follows the theme,
 * reflows on a phone, reads as a list to a screen reader and ships no script.
 * The same rail as BuildSteps runs down the left, here as a pair of wires:
 * the call goes down one, the radio's reply comes back up the other.
 */
type Owner = 'you' | 'ours' | 'hamlib' | 'platform';

interface Layer {
  name: string;
  owner: Owner;
  role: string;
  sees: string;
}

const OWNER_LABEL: Record<Owner, string> = {
  you: 'your code',
  ours: 'hamlib-wasm',
  hamlib: 'Hamlib, unmodified',
  platform: 'browser or Node',
};

const layers: Layer[] = [
  {
    name: 'Your app',
    owner: 'you',
    role: 'Asks for a frequency, in Hz.',
    sees: 'await rig.setFrequency(7_074_000)',
  },
  {
    name: 'TypeScript API',
    owner: 'ours',
    role: 'Checks the model can do it, then queues the call behind any other.',
    sees: 'rig.raw.setFrequency(7074000)',
  },
  {
    name: 'Embind facade',
    owner: 'ours',
    role: 'Generated C++ that turns the call into Hamlib’s public C API.',
    sees: 'rig_set_freq(rig, RIG_VFO_CURR, 7074000)',
  },
  {
    name: 'Rig backend',
    owner: 'hamlib',
    role: 'The Kenwood driver: the part that knows the radio’s language.',
    sees: 'FA00007074000;',
  },
  {
    name: 'Port layer',
    owner: 'hamlib',
    role: 'Upstream’s read loop, timeouts and retries, exactly as rigctl runs them.',
    sees: 'write(fd, "FA00007074000;", 14)',
  },
  {
    name: 'Serial layer',
    owner: 'ours',
    role: 'Link-time wrappers catch that write(); the fd is a handle into JavaScript.',
    sees: 'fd is ours → 14 bytes to JS',
  },
  {
    name: 'Transport',
    owner: 'ours',
    role: 'Writes to the port. Asyncify parks the C stack until the promise settles.',
    sees: 'await writer.write(bytes)',
  },
  {
    name: 'Web Serial or serialport',
    owner: 'platform',
    role: 'The USB cable, and the radio at the other end of it.',
    sees: '46 41 30 30 … 30 3B',
  },
];
---

<figure class="layers not-content">
  <ul class="legend" aria-hidden="true">
    <li data-owner="ours">hamlib-wasm</li>
    <li data-owner="hamlib">Hamlib, unmodified</li>
    <li data-owner="you">not ours: your code, the platform</li>
  </ul>
  <ol>
    <span class="wire call" aria-hidden="true" />
    <span class="wire reply" aria-hidden="true" />
    {
      layers.map((layer) => (
        <li data-owner={layer.owner}>
          <span class="tap" aria-hidden="true" />
          <div class="who">
            <strong>{layer.name}</strong>
            <span class="owner">{OWNER_LABEL[layer.owner]}</span>
          </div>
          <p class="role">{layer.role}</p>
          <code class="sees">{layer.sees}</code>
        </li>
      ))
    }
  </ol>
  <figcaption>
    One <code>setFrequency</code> on a Kenwood TS-480, layer by layer. The call
    goes down the solid wire; any reply from the radio comes back up the dashed
    one, through the same layers.
  </figcaption>
</figure>

<style>
  .layers {
    --rail: 3.5rem;
    --call: 1rem;
    --reply: 2rem;
    margin-block: 2rem;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .legend li::before {
    content: '';
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    margin-inline-end: 0.375rem;
    border-radius: 50%;
    vertical-align: -0.0625rem;
    background: var(--dot);
    border: 2px solid var(--dot-ring);
  }

  ol {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 0.5rem var(--rail);
    display: grid;
    gap: 0.375rem;
  }

  /* Two wires: the call down (solid, accent), the reply up (dashed), each
   * with its arrowhead at the end it flows to. */
  .wire {
    position: absolute;
    inset-block: 0.5rem;
    width: 2px;
    translate: -50% 0;
  }

  .wire::after {
    content: '';
    position: absolute;
    inset-inline-start: 50%;
    translate: -50% 0;
    border-inline: 0.375rem solid transparent;
  }

  .call {
    inset-inline-start: var(--call);
    background: var(--sl-color-accent);
  }

  .call::after {
    bottom: -0.5rem;
    border-top: 0.5rem solid var(--sl-color-accent);
  }

  .reply {
    inset-inline-start: var(--reply);
    background: repeating-linear-gradient(
      var(--sl-color-gray-3) 0 0.25rem,
      transparent 0.25rem 0.5rem
    );
  }

  .reply::after {
    top: -0.5rem;
    border-bottom: 0.5rem solid var(--sl-color-gray-3);
  }

  [data-owner='ours'] {
    --dot: var(--sl-color-accent);
    --dot-ring: var(--sl-color-accent);
  }

  [data-owner='hamlib'] {
    --dot: var(--sl-color-gray-2);
    --dot-ring: var(--sl-color-gray-2);
  }

  [data-owner='you'],
  [data-owner='platform'] {
    --dot: var(--sl-color-black);
    --dot-ring: var(--sl-color-gray-3);
  }

  ol > li {
    position: relative;
    display: grid;
    grid-template-columns: 10.5rem 1fr minmax(0, 17rem);
    gap: 0.25rem 1.25rem;
    align-items: center;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-inline-start: 3px solid var(--dot-ring);
    border-radius: 0.375rem;
    background: var(--sl-color-gray-6);
  }

  ol > li[data-owner='hamlib'] {
    background: var(--sl-color-black);
  }

  ol > li[data-owner='you'],
  ol > li[data-owner='platform'] {
    border-style: dashed;
    border-inline-start-style: solid;
    background: transparent;
  }

  /* Where each layer taps the wires: a stub across both, a dot on the call. */
  .tap {
    position: absolute;
    inset-inline-start: calc(var(--call) - var(--rail));
    top: 50%;
    width: calc(var(--rail) - var(--call));
    height: 2px;
    translate: 0 -50%;
    background: linear-gradient(
      90deg,
      transparent 0.5rem,
      color-mix(in srgb, var(--dot-ring) 55%, transparent) 0.5rem
    );
  }

  .tap::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    width: 0.75rem;
    height: 0.75rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--dot);
    border: 2px solid var(--dot-ring);
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .who strong {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .owner {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  [data-owner='ours'] .owner {
    color: var(--sl-color-accent-high);
  }

  .role {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  /* What travels: a packet on the wire, not a code sample. */
  .sees {
    justify-self: start;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-1);
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline-light);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    overflow-wrap: anywhere;
  }

  [data-owner='ours'] .sees {
    background: var(--sl-color-accent-low);
    border-color: transparent;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 50rem) {
    .layers {
      --rail: 2.75rem;
      --call: 0.75rem;
      --reply: 1.5rem;
    }

    ol > li {
      grid-template-columns: 1fr;
    }

    .tap {
      top: 1.6rem;
    }
  }
</style>
