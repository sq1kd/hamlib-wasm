{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["w3c-web-serial", "node"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "src/content/docs/api"]
}
