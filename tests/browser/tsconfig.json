{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../.cache/tsc/tests-browser.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "w3c-web-serial"]
  },
  "include": ["**/*.ts", "**/*.d.ts"],
  /* The in-page fixtures are standalone scripts with their own project
   * (fixtures/tsconfig.json).  The spec project reads what they publish
   * (fixtures-globals.d.ts, and rigs.ts for the registry's names) but does not
   * check the scripts themselves; fixtures/compile.ts stays in. */
  "exclude": [
    "fixtures/virtual-clock.ts",
    "fixtures/fake-port.ts",
    "fixtures/fake-serial.ts",
    "fixtures/helpers.ts"
  ]
}
